void setup() {

  SPI.begin();
  tft.initR(INITR_BLACKTAB);
  tft.setRotation(1);
  tft.fillScreen(ST7735_BLACK);

  Wire.begin();
  if(!oled.begin(SSD1306_SWITCHCAPVCC, 0x3C)) {
    for(;;);
  }

  oled.clearDisplay();
  oled.print("Welcome!");
  oled.display();
  delay(1000);
}

void loop() {

  //OLED Display
  oled.clearDisplay();
  oled.drawBitmap(0, 0, Mewo_01, FRAME_WIDTH, FRAME_HEIGHT, SSD1306_WHITE);
  oled.display();
  
  //TFT Display
  tft.drawRGBBitmap(0, 0, (const uint16_t*)Omori_01, IMG_WIDTH, IMG_HEIGHT);

  delay(1000);

  oled.clearDisplay();
  oled.drawBitmap(0, 0, Mewo_02, FRAME_WIDTH, FRAME_HEIGHT, SSD1306_WHITE);
  oled.display();
  
  tft.drawRGBBitmap(0, 0, (const uint16_t*)Omori_02, IMG_WIDTH, IMG_HEIGHT);
  
  delay(1000);



}